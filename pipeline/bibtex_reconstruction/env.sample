# ============================================================
# 必須
# ============================================================

# Gemini API キー（BibTeXキー生成のLLMに使用）
# llm_utils.py でモジュールロード時に genai.Client() へ渡される
GEMINI_API_KEY=gemini_api_key

# ============================================================
# 任意（設定すると機能強化・レート制限緩和）
# ============================================================

# Crossref API 連絡先メールアドレス
# 設定すると "polite pool"（優先レーン）を利用できる
CROSSREF_MAILTO=yourname@example.com

# CiNii API アプリケーションID
CINII_APPID=your_cinii_appid

# Semantic Scholar API キー
# 未設定だと匿名アクセス（レート制限：100 req/5min 程度）
SEMANTIC_SCHOLAR_API_KEY=your_s2_api_key