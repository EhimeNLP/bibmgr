# 意味的なBibTeX復元に利用するLLM
BIBTEX_RECONSTRUCTION_LLM_PROVIDER=gemini
BIBTEX_RECONSTRUCTION_LLM_MODEL=gemini-2.5-pro
BIBTEX_RECONSTRUCTION_LLM_API_KEY=your-provider-api-key
# OpenAI互換APIやlocal serverを利用する場合に設定
BIBTEX_RECONSTRUCTION_LLM_BASE_URL=

# 通常は変更不要な実行設定
# BIBTEX_RECONSTRUCTION_SIMILARITY_THRESHOLD=0.95
# BIBTEX_RECONSTRUCTION_TRUSTED_DOI_THRESHOLD=0.97
# BIBTEX_RECONSTRUCTION_MAX_PARALLEL_REQUESTS=5
# BIBTEX_RECONSTRUCTION_LLM_MAX_ATTEMPTS=3
# BIBTEX_RECONSTRUCTION_REGISTRATION_POLICY=laboratory
# BIBTEX_RECONSTRUCTION_REWRITE_CITATION_KEYS=true

# Crossref API 連絡先メールアドレス
# 設定すると "polite pool"（優先レーン）を利用できる
CROSSREF_MAILTO=your-mailadress

# CiNii API アプリケーションID
CINII_APPID=your-cinii-appid

# Semantic Scholar API キー
# 未設定だと匿名アクセス（レート制限：100 req/5min 程度）
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
