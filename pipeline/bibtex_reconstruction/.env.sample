# Primary local open-source LLM served by vLLM
BIBTEX_RECONSTRUCTION_LOCAL_LLM_ENABLED=true
BIBTEX_RECONSTRUCTION_LOCAL_LLM_MODEL=Qwen/Qwen3-32B-AWQ
BIBTEX_RECONSTRUCTION_LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
BIBTEX_RECONSTRUCTION_LOCAL_LLM_API_KEY=
BIBTEX_RECONSTRUCTION_LOCAL_LLM_TIMEOUT=120
BIBTEX_RECONSTRUCTION_LOCAL_LLM_TEMPERATURE=0
BIBTEX_RECONSTRUCTION_LOCAL_LLM_MAX_OUTPUT_TOKENS=2048
BIBTEX_RECONSTRUCTION_LOCAL_LLM_SEED=0
BIBTEX_RECONSTRUCTION_CONCEPT_RANKING_BATCH_SIZE=32

# Remote API LLMs are disabled by default and are only a final fallback
BIBTEX_RECONSTRUCTION_REMOTE_LLM_FALLBACK_ENABLED=false
# BIBTEX_RECONSTRUCTION_LLM_PROVIDER=gemini
# BIBTEX_RECONSTRUCTION_LLM_MODEL=gemini-flash-lite-latest
# BIBTEX_RECONSTRUCTION_LLM_API_KEY=
# BIBTEX_RECONSTRUCTION_LLM_BASE_URL=

# BibMgR Local DB search
BIBTEX_RECONSTRUCTION_LOCAL_DB_ENABLED=false
BIBTEX_RECONSTRUCTION_LOCAL_DB_BASE_URL=http://127.0.0.1:8000/references/page
# Set the complete Cookie header value when authentication is required
BIBTEX_RECONSTRUCTION_LOCAL_DB_COOKIE=

# Runtime tuning
# BIBTEX_RECONSTRUCTION_SIMILARITY_THRESHOLD=0.95
# BIBTEX_RECONSTRUCTION_TRUSTED_DOI_THRESHOLD=0.97
# BIBTEX_RECONSTRUCTION_REFERENCE_THREADS=2
# BIBTEX_RECONSTRUCTION_API_THREADS=3
# BIBTEX_RECONSTRUCTION_DOI_WAIT_SEC=0.1
# BIBTEX_RECONSTRUCTION_CITATION_SITE_WAIT_SEC=0.5
# BIBTEX_RECONSTRUCTION_CITATION_SITE_TIMEOUT=15
# BIBTEX_RECONSTRUCTION_CITATION_SITE_MAX_BYTES=2000000
# BIBTEX_RECONSTRUCTION_CITATION_SITE_MAX_LINKS=5
# BIBTEX_RECONSTRUCTION_CITATION_SITE_MAX_REDIRECTS=5
# BIBTEX_RECONSTRUCTION_CROSSREF_WAIT_SEC=1
# BIBTEX_RECONSTRUCTION_CINII_WAIT_SEC=1
# BIBTEX_RECONSTRUCTION_SEMANTICSCHOLAR_WAIT_SEC=1
# BIBTEX_RECONSTRUCTION_JSTAGE_WAIT_SEC=0.5
# BIBTEX_RECONSTRUCTION_ARXIV_WAIT_SEC=3

# vLLM server tuning for one RTX PRO 6000 Blackwell
# BIBTEX_RECONSTRUCTION_VLLM_TENSOR_PARALLEL_SIZE=1
# BIBTEX_RECONSTRUCTION_VLLM_MAX_MODEL_LEN=8192
# BIBTEX_RECONSTRUCTION_VLLM_MAX_NUM_SEQS=8
# BIBTEX_RECONSTRUCTION_VLLM_GPU_MEMORY_UTILIZATION=0.85

# Crossref polite pool contact
CROSSREF_MAILTO=your-mail-address

# CiNii API application ID
CINII_APPID=your-cinii-appid

# Semantic Scholar API key
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
