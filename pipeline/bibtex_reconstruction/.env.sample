# 意味的なBibTeX復元に利用するLLM
BIBTEX_RECONSTRUCTION_LLM_PROVIDER=gemini
BIBTEX_RECONSTRUCTION_LLM_MODEL=gemini-flash-lite-latest
BIBTEX_RECONSTRUCTION_LLM_API_KEY=your-provider-api-key
# OpenAI互換APIやlocal serverを利用する場合に設定
BIBTEX_RECONSTRUCTION_LLM_BASE_URL=

# 通常は変更不要な実行設定
# BIBTEX_RECONSTRUCTION_SIMILARITY_THRESHOLD=0.95
# BIBTEX_RECONSTRUCTION_TRUSTED_DOI_THRESHOLD=0.97
# BIBTEX_RECONSTRUCTION_REFERENCE_THREADS=2
# BIBTEX_RECONSTRUCTION_API_THREADS=3
# BIBTEX_RECONSTRUCTION_LLM_MAX_ATTEMPTS=3
# BIBTEX_RECONSTRUCTION_DOI_WAIT_SEC=0.1
# BIBTEX_RECONSTRUCTION_CITATION_SITE_WAIT_SEC=0.5
# BIBTEX_RECONSTRUCTION_CITATION_SITE_TIMEOUT=15
# BIBTEX_RECONSTRUCTION_CITATION_SITE_MAX_BYTES=2000000
# BIBTEX_RECONSTRUCTION_CITATION_SITE_MAX_LINKS=5
# BIBTEX_RECONSTRUCTION_CITATION_SITE_MAX_REDIRECTS=5
# BIBTEX_RECONSTRUCTION_CROSSREF_WAIT_SEC=1
# BIBTEX_RECONSTRUCTION_CINII_WAIT_SEC=1
# BIBTEX_RECONSTRUCTION_SEMANTICSCHOLAR_WAIT_SEC=1
# BIBTEX_RECONSTRUCTION_JSTAGE_WAIT_SEC=0.5
# BIBTEX_RECONSTRUCTION_ARXIV_WAIT_SEC=3

# Crossref API 連絡先メールアドレス
# 設定すると "polite pool"（優先レーン）を利用できる
CROSSREF_MAILTO=your-mailadress

# CiNii API アプリケーションID
CINII_APPID=your-cinii-appid

# Semantic Scholar API キー
# 未設定だと匿名アクセス（レート制限：100 req/5min 程度）
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
