        {
            "block_label": "paragraph_title",
            "block_content": "2.2 自然言語処理に基づく診断支援",
            "block_bbox": [
                107,
                937,
                509,
                966
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
