        {
            "block_label": "figure_title",
            "block_content": "Table 7: Evaluation of MAE and QWK in estimating objective emotional intensity.",
            "block_bbox": [
                258,
                444,
                929,
                469
            ],
            "block_id": 1,
            "block_order": null,
            "group_id": 1,
            "global_block_id": 112,
            "global_group_id": 112,
            "block_polygon_points": [
                [
