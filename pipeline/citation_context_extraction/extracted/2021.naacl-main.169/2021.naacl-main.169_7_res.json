        {
            "block_label": "paragraph_title",
            "block_content": "5.2.2 Evaluation with Objective Labels",
            "block_bbox": [
                136,
                1168,
                521,
                1194
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "global_block_id": 116,
            "global_group_id": 116,
            "block_polygon_points": [
                [
                    136.0,
