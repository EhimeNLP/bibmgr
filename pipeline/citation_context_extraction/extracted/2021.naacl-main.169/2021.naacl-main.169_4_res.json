        },
        {
            "block_label": "paragraph_title",
            "block_content": "4.2 Difference between Writers and Readers",
            "block_bbox": [
                136,
                1178,
                575,
                1204
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 68,
            "global_group_id": 68,
            "block_polygon_points": [
                [
                    136.0,
