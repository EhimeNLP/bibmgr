            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2 Related Work",
            "block_bbox": [
                136,
                1298,
                325,
                1325
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "global_block_id": 21,
            "global_group_id": 21,
            "block_polygon_points": [
                [
                    136.0,
