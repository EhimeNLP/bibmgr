        },
        {
            "block_label": "text",
            "block_content": "ISEAR (Scherer and Wallbott, 1994) is a dataset with subjective emotional labels. This is a dataset in which annotators describe their own past events in each emotion. They use a label set that adds shame and guilt to Ekman's six emotions. Although ISEAR is the only dataset with subjective emotional labels, their intensity is not considered.",
            "block_bbox": [
                604,
                705,
                1055,
                893
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "global_block_id": 24,
            "global_group_id": 24,
            "block_polygon_points": [
                [
