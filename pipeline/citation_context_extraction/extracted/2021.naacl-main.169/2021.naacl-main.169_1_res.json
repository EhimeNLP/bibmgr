        {
            "block_label": "figure_title",
            "block_content": "Table 1: List of datasets with emotional intensity. In the “Emotion” column, datasets with E6 adopt the six emotions by Ekman (1992): anger, disgust, fear, joy, sadness, surprise, ones with P8 adopts the eight emotions by Plutchik (1980): anger, disgust, fear, joy, sadness, surprise, trust, anticipation, and ones with M4 adopts the four emotions by Mohammad et al.: joy, sadness, anger, fear.",
            "block_bbox": [
