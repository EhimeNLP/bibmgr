        {
            "block_label": "paragraph_title",
            "block_content": "3.2 Annotating Objective Labels",
            "block_bbox": [
                606,
                894,
                935,
                920
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
