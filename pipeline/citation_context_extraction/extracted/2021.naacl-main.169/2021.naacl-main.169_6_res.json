        {
            "block_label": "text",
            "block_content": "We used scikit-learn $ ^{16} $ (Pedregosa et al., 2011) implementation for both BoW+LogReg and fastText+SVM models. For the hyper-parameter of C, the optimum value over the validation set was selected from {0.01, 0.1, 1, 10, 100}.",
            "block_bbox": [
                135,
                941,
                584,
                1076
            ],
            "block_id": 6,
