            ]
        },
        {
            "block_label": "text",
            "block_content": "In the evaluation of subjective labels, the personality of the writers is considered in the Subj. BERT in the following two ways.",
            "block_bbox": [
                136,
                1268,
                585,
                1349
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "global_block_id": 100,
