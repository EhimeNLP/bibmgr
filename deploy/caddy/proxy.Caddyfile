{
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 60s
			idle 2m
		}
		trusted_proxies static {$BIBMGR_TRUSTED_PROXY_CIDRS}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		max_header_size 32KB
	}
}

:80 {
	import /etc/caddy/bibmgr/common.caddy

	redir {$BIBMGR_BASE_PATH:/bibmgr} {$BIBMGR_BASE_PATH:/bibmgr}/ 308

	handle {$BIBMGR_BASE_PATH:/bibmgr}/api/metrics* {
		respond 404
	}

	handle_path {$BIBMGR_BASE_PATH:/bibmgr}/api/* {
		request_body {
			max_size {$BIBMGR_MAX_REQUEST_BODY_BYTES:1048576}
		}
		reverse_proxy backend:8000 {
			unhealthy_request_count 128
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				max_conns_per_host 128
			}
		}
	}

	handle_path {$BIBMGR_BASE_PATH:/bibmgr}/* {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	respond 404

	handle_errors {
		import /etc/caddy/bibmgr/security-headers.caddy
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
