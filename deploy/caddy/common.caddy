encode zstd gzip

header {
	Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'"
	Permissions-Policy "camera=(), geolocation=(), microphone=()"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
}
