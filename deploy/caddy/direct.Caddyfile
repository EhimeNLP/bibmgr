{
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 60s
			idle 2m
		}
		max_header_size 32KB
	}
}

{$BIBMGR_SITE_ADDRESS} {
	import /etc/caddy/bibmgr/common.caddy

	handle /api/metrics* {
		respond 404
	}

	handle_path /api/* {
		request_body {
			max_size {$BIBMGR_MAX_REQUEST_BODY_BYTES:1048576}
		}
		reverse_proxy backend:8000 {
			unhealthy_request_count 128
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 30s
				max_conns_per_host 128
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		import /etc/caddy/bibmgr/security-headers.caddy
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
