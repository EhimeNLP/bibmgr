[Unit]
Description=Remove expired BibMgR authentication records
Requires=bibmgr.service
After=bibmgr.service

[Service]
Type=oneshot
WorkingDirectory=/opt/bibmgr
Environment=BIBMGR_DEPLOYMENT_MODE=direct
EnvironmentFile=-/etc/default/bibmgr
ExecStart=/usr/bin/docker compose --env-file .env.production -f compose.production.yaml -f compose.production.${BIBMGR_DEPLOYMENT_MODE}.yaml run --rm --no-deps backend bibmgr-admin cleanup-auth
