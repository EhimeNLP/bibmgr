[Unit]
Description=Back up the BibMgR PostgreSQL database
Requires=bibmgr.service
After=bibmgr.service

[Service]
Type=oneshot
WorkingDirectory=/opt/bibmgr
ExecStart=/usr/bin/docker compose --env-file .env.production -f compose.production.yaml run --rm --no-deps backend bibmgr-ops backup --output-dir /var/lib/bibmgr/backups
