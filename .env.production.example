BIBMGR_IMAGE_TAG=local

# Direct HTTPS mode
BIBMGR_SITE_ADDRESS=bibmgr.example.com

# External reverse-proxy mode
BIBMGR_BASE_PATH=/bibmgr
BIBMGR_WEB_BIND_ADDRESS=127.0.0.1
BIBMGR_WEB_PORT=8080
# Replace this with the exact source CIDRs observed by Caddy.
BIBMGR_TRUSTED_PROXY_CIDRS=192.0.2.10/32

BIBMGR_AUTH_EMAIL_DOMAIN=example.com
BIBMGR_EMAIL_FROM=bibmgr@example.com
BIBMGR_SMTP_HOST=smtp.example.com
BIBMGR_SMTP_PORT=465
BIBMGR_SMTP_SECURITY=implicit_tls
BIBMGR_SMTP_USERNAME=bibmgr@example.com

# Comma-separated exact addresses. Domains and wildcard patterns are rejected.
BIBMGR_AUTH_ALLOWED_EMAILS=collaborator@example.org,visitor@example.net

# Abuse-resistance defaults. Tune only after observing legitimate traffic.
BIBMGR_MAX_REQUEST_BODY_BYTES=1048576
BIBMGR_RATE_LIMIT_GLOBAL_PER_MINUTE=600
BIBMGR_RATE_LIMIT_GLOBAL_BURST=120
BIBMGR_RATE_LIMIT_AUTH_START_PER_MINUTE=10
BIBMGR_RATE_LIMIT_AUTH_START_BURST=20
BIBMGR_RATE_LIMIT_AUTH_VERIFY_PER_MINUTE=30
BIBMGR_RATE_LIMIT_AUTH_VERIFY_BURST=30
BIBMGR_RATE_LIMIT_AUTH_SESSION_PER_MINUTE=180
BIBMGR_RATE_LIMIT_AUTH_SESSION_BURST=60
BIBMGR_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=600
BIBMGR_RATE_LIMIT_AUTHENTICATED_BURST=120
BIBMGR_RATE_LIMIT_AUTHENTICATED_WRITE_PER_MINUTE=120
BIBMGR_RATE_LIMIT_AUTHENTICATED_WRITE_BURST=30
BIBMGR_RATE_LIMIT_MAX_KEYS=10000

# Container ceilings and bounded local logs.
BIBMGR_POSTGRES_MEMORY_LIMIT=2g
BIBMGR_POSTGRES_CPU_LIMIT=2.0
BIBMGR_POSTGRES_PIDS_LIMIT=256
BIBMGR_MIGRATE_MEMORY_LIMIT=1g
BIBMGR_MIGRATE_CPU_LIMIT=2.0
BIBMGR_MIGRATE_PIDS_LIMIT=256
BIBMGR_BACKEND_MEMORY_LIMIT=1g
BIBMGR_BACKEND_CPU_LIMIT=2.0
BIBMGR_BACKEND_PIDS_LIMIT=256
BIBMGR_WEB_MEMORY_LIMIT=256m
BIBMGR_WEB_CPU_LIMIT=1.0
BIBMGR_WEB_PIDS_LIMIT=128
BIBMGR_UVICORN_LIMIT_CONCURRENCY=64
BIBMGR_UVICORN_BACKLOG=128
BIBMGR_UVICORN_TIMEOUT_KEEP_ALIVE=5
BIBMGR_UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30
BIBMGR_LOG_MAX_SIZE=10m
BIBMGR_LOG_MAX_FILES=5

# Override these only when the secret files live outside deploy/secrets/.
BIBMGR_DATABASE_PASSWORD_FILE=./deploy/secrets/database_password
BIBMGR_DATABASE_URL_FILE=./deploy/secrets/database_url
BIBMGR_AUTH_SECRET_FILE=./deploy/secrets/auth_secret
BIBMGR_SMTP_PASSWORD_FILE=./deploy/secrets/smtp_password
