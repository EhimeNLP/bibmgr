BIBMGR_IMAGE_TAG=local

# Direct HTTPS mode
BIBMGR_SITE_ADDRESS=bibmgr.example.com

# External reverse-proxy mode
BIBMGR_BASE_PATH=/bibmgr
BIBMGR_WEB_BIND_ADDRESS=127.0.0.1
BIBMGR_WEB_PORT=8080

BIBMGR_AUTH_EMAIL_DOMAIN=example.com
BIBMGR_EMAIL_FROM=bibmgr@example.com
BIBMGR_SMTP_HOST=smtp.example.com
BIBMGR_SMTP_PORT=465
BIBMGR_SMTP_SECURITY=implicit_tls
BIBMGR_SMTP_USERNAME=bibmgr@example.com

# Comma-separated exact addresses. Domains and wildcard patterns are rejected.
BIBMGR_AUTH_ALLOWED_EMAILS=collaborator@example.org,visitor@example.net

# Override these only when the secret files live outside deploy/secrets/.
BIBMGR_DATABASE_PASSWORD_FILE=./deploy/secrets/database_password
BIBMGR_DATABASE_URL_FILE=./deploy/secrets/database_url
BIBMGR_AUTH_SECRET_FILE=./deploy/secrets/auth_secret
BIBMGR_SMTP_PASSWORD_FILE=./deploy/secrets/smtp_password
